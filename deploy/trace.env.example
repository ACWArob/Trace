# Copy to /etc/trace/trace.env, readable only by root. Replace this example host.
TRACE_ENV=production
TRACE_PUBLIC_ORIGIN=https://trace.example.com
TRACE_TRUST_PROXY=1
TRACE_SIGNUP_MODE=invite
TRACE_DATA_DIR=/var/lib/trace
# 100 MiB of saved private library data per account for this beta.
TRACE_LIBRARY_BYTES=104857600
# Configure provider keys privately here if enabled. Never put real values in Git.
# MDBLIST_API_KEY=
# GOOGLE_BOOKS_API_KEY=
